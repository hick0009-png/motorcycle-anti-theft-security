<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disable cleartext HTTP traffic across the entire application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Certificate Pinning Configuration for Telegram Bot API -->
    <domain-config>
        <domain includeSubdomains="true">api.telegram.org</domain>
        <pin-set expiration="2027-01-01">
            <!-- Primary Certificate Hash for api.telegram.org -->
            <!-- Backup Certificate Hash -->
            <pin digest="SHA-256">Y9mvm0exBk1JoQ557r9S1aB2cBZn6EesEARfNSc8dOf=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
