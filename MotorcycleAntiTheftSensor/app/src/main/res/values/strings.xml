<resources>
    <!--
      The manifest resolves android:label itself, so this one string has to be a
      resource. Every other line the owner reads lives in PresentationTextCatalog:
      most of the app's Thai is written by formatters that have no Context to look a
      resource up with, and a second home only ever held copies of what was there.
    -->
    <string name="app_name">MotorcycleAntiTheftSensor</string>
</resources>
