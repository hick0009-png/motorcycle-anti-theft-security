{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hcp-checkpoint.schema.json",
  "title": "HCP Checkpoint",
  "description": "Schema for HCP checkpoint files saved at d:\\security\\.hcp\\checkpoints\\",
  "type": "object",
  "required": ["id", "timestamp", "phase", "task_id", "status", "description", "agent", "snapshot"],
  "properties": {

    "id": {
      "type": "string",
      "pattern": "^CKP-[0-9]{8}-[0-9]{4}-[A-Z0-9]{6}$",
      "description": "Unique checkpoint ID. Format: CKP-YYYYMMDD-HHMM-XXXXXX",
      "examples": ["CKP-20260806-2121-SEC01A"]
    },

    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when checkpoint was saved",
      "examples": ["2026-08-06T21:21:00+07:00"]
    },

    "phase": {
      "type": "string",
      "enum": ["P1", "P2", "P3", "P4", "P5", "P6"],
      "description": "Development phase at time of checkpoint"
    },

    "task_id": {
      "type": "string",
      "pattern": "^(SEC|SEN|SVC|COM|UI)-[0-9]{2}$",
      "description": "Current task ID",
      "examples": ["SEC-01", "SEN-02", "COM-01"]
    },

    "status": {
      "type": "string",
      "enum": ["PLANNED", "IN_PROGRESS", "DONE", "FAILED", "SKIPPED", "BLOCKED"],
      "description": "Status of the task at checkpoint time"
    },

    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Human-readable description of what was done at this checkpoint"
    },

    "agent": {
      "type": "object",
      "required": ["name", "model", "conversation_id"],
      "properties": {
        "name": { "type": "string", "examples": ["Antigravity", "Cursor", "Claude"] },
        "model": { "type": "string", "examples": ["claude-opus-4.6", "gemini-3.6-flash"] },
        "conversation_id": { "type": "string" }
      }
    },

    "snapshot": {
      "type": "object",
      "required": ["files_changed", "build_status"],
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "action"],
            "properties": {
              "path": { "type": "string" },
              "action": { "type": "string", "enum": ["CREATED", "MODIFIED", "DELETED"] },
              "lines": { "type": "integer" }
            }
          }
        },
        "build_status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED", "NOT_RUN", "WARNING"]
        },
        "build_output_snippet": { "type": "string" },
        "test_results": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer" },
            "failed": { "type": "integer" },
            "skipped": { "type": "integer" }
          }
        }
      }
    },

    "decisions": {
      "type": "array",
      "description": "Key decisions made during this task",
      "items": {
        "type": "object",
        "required": ["question", "decision"],
        "properties": {
          "question": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "decided_by": { "type": "string", "enum": ["user", "agent", "council"] }
        }
      }
    },

    "open_tasks": {
      "type": "array",
      "description": "Tasks still pending after this checkpoint",
      "items": {
        "type": "object",
        "required": ["task_id", "description", "priority"],
        "properties": {
          "task_id": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "blocked_by": { "type": "string" }
        }
      }
    },

    "context": {
      "type": "object",
      "description": "Additional context for session handoff",
      "properties": {
        "summary": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "next_steps": { "type": "array", "items": { "type": "string" } },
        "environment": {
          "type": "object",
          "properties": {
            "java_version": { "type": "string" },
            "android_sdk": { "type": "string" },
            "gradle_version": { "type": "string" },
            "kotlin_version": { "type": "string" }
          }
        }
      }
    },

    "git": {
      "type": "object",
      "properties": {
        "commit_hash": { "type": "string" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean", "description": "True if there are uncommitted changes" },
        "remote_url": { "type": "string" }
      }
    },

    "parent_checkpoint_id": {
      "type": ["string", "null"],
      "description": "ID of the previous checkpoint (null for first)",
      "examples": ["CKP-20260806-2100-ROOT01", null]
    },

    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "examples": [["security", "encryption", "keystore"]]
    },

    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall progress percentage"
    },
    "scope": {
      "type": "string",
      "description": "Scope of the current work"
    },
    "knowledge": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Important discoveries made during work"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assumption": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "needsValidation": { "type": "boolean" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string" },
          "impact": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "memory_snapshot": {
      "type": "array",
      "description": "Key-value pairs of important context for session handoff",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Things that must happen before this work can proceed"
    },
    "error_info": {
      "type": "object",
      "properties": {
        "error_type": { "type": "string", "enum": ["tool_error", "api_failure", "timeout", "user_abort", "exception", "script_execution_error", "unknown"] },
        "error_message": { "type": "string" },
        "error_timestamp": { "type": "string", "format": "date-time" },
        "actions_before_error": { "type": "array", "items": { "type": "string" } },
        "tool_used": { "type": "string" },
        "stack_trace": { "type": "string" },
        "recovery_instruction": { "type": "string" }
      }
    }
  }
}
